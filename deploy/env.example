# PlacePix production configuration - copy to /opt/placepix/.env
#
# This file holds secrets. It is never in git and never enters the Docker build
# context. Back it up somewhere safe: it is the only copy.
#
# Only deployment-level settings are listed here. Every application setting is
# documented in the repository's .env.example and can be added below.

# ── Deployment ──────────────────────────────────────────────────────
# Image tag to run. Pin a version to freeze or roll back (e.g. 0.3).
PLACEPIX_TAG=latest

# Port the app listens on, and the port nginx proxies to.
PORT=3000

# Address the port is published on. Loopback because nginx fronts the app.
# Use 0.0.0.0 only if nothing is proxying in front of it.
BIND_ADDR=127.0.0.1

# Container memory ceiling.
MEMORY_LIMIT=1g

# Uvicorn workers.
WORKERS=2

# ── Site ────────────────────────────────────────────────────────────
SITE_URL=https://placepix.net
SEO_ENABLED=true

# Disable uploads on a public instance.
UPLOAD_ENABLED=false

LOG_LEVEL=INFO

# ── Cache ───────────────────────────────────────────────────────────
CACHE=true
CACHE_TTL_HOURS=336
CACHE_CLEANUP_INTERVAL_MINUTES=720
CACHE_MAX_SIZE_MB=1024

# ── S3-compatible storage (optional) ────────────────────────────────
# S3_ENABLED=false
# S3_ENDPOINT=https://s3.rbx.io.cloud.ovh.net
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=rbx

# ── AI generation (optional) ────────────────────────────────────────
# AI_GENERATION_ENABLED=false
# OVH_AI_ENDPOINTS_TOKEN=

# ── Analytics (optional) ────────────────────────────────────────────
# GA_TRACKING_ID=
