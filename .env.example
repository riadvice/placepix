# Optional configuration for PlacePix
# All values have sensible defaults in src/config.py

# HOST=127.0.0.1:3000
# WORKERS=2
# DIR=./data
# SEED_DIR=./images
# CACHE=true
# CDN=
# MIN_WIDTH=8
# MIN_HEIGHT=8
# MAX_WIDTH=2000
# MAX_HEIGHT=2000
# UPLOAD_ENABLED=true

# Seed images (optional, disabled by default)
# SEED_ENABLED=false

# Admin (leave empty to disable metrics and admin endpoints)
# ADMIN_PASSWORD=your-secure-password

# Watermark (optional)
# WATERMARK_ENABLED=false
# WATERMARK_IMAGE=./watermark.png
# WATERMARK_TEXT=
# WATERMARK_POSITION=bottom-right
# WATERMARK_OPACITY=0.5

# Google Analytics (optional)
# GA_TRACKING_ID=G-XXXXXXXXXX

# Logging
# LOG_LEVEL=INFO

# Cache TTL / cleanup (default: 336 hours = 2 weeks, cleanup every 12 hours)
# CACHE_TTL_HOURS=336
# CACHE_CLEANUP_INTERVAL_MINUTES=720

# S3-compatible storage (optional; works with OVHcloud, AWS, MinIO, etc.)
# S3_ENABLED=false
# S3_ENDPOINT=https://s3.rbx.io.cloud.ovh.net
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=your-bucket-name
# S3_PREFIX=
# S3_REGION=rbx
